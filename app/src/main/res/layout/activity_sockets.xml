<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ZMQ Sockets"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvServerIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сервер: 192.168.1.100:5555"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnStartTransfer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Начать передачу данных"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnStopTransfer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Остановить"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvSockets"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#EEEEEE"
        android:padding="12dp"
        android:text="Лог пуст"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:scrollbars="vertical" />

</LinearLayout>